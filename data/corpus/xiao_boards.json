        {"xiao_pin": "D9", "chip_pin": "GPIO8", "functions": ["SPI MISO", "ADC", "touch", "SD card MISO on Sense"]},
        {"xiao_pin": "D10", "chip_pin": "GPIO9", "functions": ["SPI MOSI", "ADC", "touch"]},
        {"xiao_pin": "Boot", "chip_pin": "GPIO0", "functions": ["enter boot mode"]}
